  "narrative": {
    "northStar": "The Counter With the Ledger Open",
    "overview": "A shop counter where the customer is talking and their order slip lies open beside you. The screen is a warm cream working ground, white panes divided by warm hairlines, and a night rail at the inline-start edge carrying the gold doorway mark. Everything is quiet so that one thing can be loud: brass-gold marks the single thing that needs doing now.\n\nIt is Arabic-first and right-to-left: layout uses logical properties, mirrors directional motion, and customer text sets its own direction. Readex Pro carries Arabic and Latin in one voice with tabular numerals. Density is operator-grade: 44px targets, 10-14px radii, no decoration that does not carry status.\n\nThe signature is the brass rail of order stops that fills gold as the order advances.",
    "keyCharacteristics": [
      "Cream ground, white panes, night rail; one brass-gold accent used sparingly.",
      "Flat: hairlines and tonal sand/cream steps carry depth; shadow only on floating layers.",
      "Order progress drawn as structure, not a badge.",
      "Status (sent, read, failed, window closing) always visible in colour plus text.",
      "Colour never carries meaning alone; Arabic and English both complete."
    ],
    "rules": [
      { "name": "The One Voice Rule", "body": "Gold marks only what needs action or attention now. A screen with gold on decoration has spent its voice.", "section": "colors" },
      { "name": "The No Orange Rule", "body": "No orange anywhere in Ebda's own UI; the gold is brass, not amber.", "section": "colors" },
      { "name": "The Gold Is Not Text Rule", "body": "Gold on light grounds is a fill or ring; text in that role uses Gold Ink.", "section": "colors" },
      { "name": "The Tabular Rule", "body": "Numerals are tabular everywhere.", "section": "typography" },
      { "name": "The Own-Direction Rule", "body": "Customer-authored text uses dir=auto / unicode-bidi: plaintext and text-align: start; never impose the UI direction on it.", "section": "typography" },
      { "name": "The No Letter Motion Rule", "body": "No per-letter animation (breaks Arabic joining).", "section": "typography" },
      { "name": "The Floating-Only Rule", "body": "If it is not floating above the page, it has no shadow.", "section": "elevation" },
      { "name": "The No Gradient Rule", "body": "No gradients, no glass. The single exception is the mask fade at the quick-reply strip's scroll edge.", "section": "elevation" }
    ],
    "dos": [
      "Do spend gold only on the one needed action, unread count, unseen-COD dot, selection ring and the rail fill.",
      "Do keep every target 44px on touch and every status as colour plus word.",
      "Do use logical properties and mirror directional motion in RTL.",
      "Do mark sample data visibly (the sample badge) until live data lands.",
      "Do respect prefers-reduced-motion (all animation and transitions are cut)."
    ],
    "donts": [
      "Don't add orange, gradients (beyond the quick-reply fade mask), glass or resting shadows.",
      "Don't put a coloured stripe or border-inline-start accent on rows; selection is tint plus avatar ring.",
      "Don't use gold as text colour on light grounds; use Gold Ink.",
      "Don't animate text per letter or impose the UI direction on customer content.",
      "Don't hard-code \"Ebda\" in the brand-neutral core; white-label copies reuse it."
    ]
  }
