{
 "version": 1,
 "cases": [
  {
   "name": "profile",
   "method": "getStoreProfile",
   "args": [
    "11111111-1111-4111-8111-111111111111"
   ],
   "expect": {
    "ok": true,
    "value": {
     "name": "Dar Mona",
     "logoUrl": "https://cdn.example/logo.png",
     "locale": "ar",
     "currency": "EGP",
     "paymentMethods": [
      "cod",
      "link",
      "instapay"
     ],
     "codEnabled": true,
     "instapay": {
      "ipa": "dar-mona@instapay",
      "displayName": "Dar Mona"
     }
    }
   }
  },
  {
   "name": "profile of a store that does not resolve is not_found, never a default",
   "method": "getStoreProfile",
   "args": [
    "33333333-3333-4333-8333-333333333333"
   ],
   "expect": {
    "ok": false,
    "reason": "not_found",
    "message": "store not resolved"
   }
  },
  {
   "name": "profile of an unlinked store is not_linked",
   "method": "getStoreProfile",
   "args": [
    "22222222-2222-4222-8222-222222222222"
   ],
   "expect": {
    "ok": false,
    "reason": "not_linked"
   }
  },
  {
   "name": "malformed store id is invalid",
   "method": "getStoreProfile",
   "args": [
    "not-a-uuid"
   ],
   "expect": {
    "ok": false,
    "reason": "invalid",
    "message": "storeId"
   }
  },
