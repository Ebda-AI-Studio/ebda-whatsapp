{
  "product": "chat",
  "mustConfirm": [
    { "pattern": "/wallet(/|$)", "method": "POST" },
    { "pattern": "/packages(/|$)", "method": "POST" },
    { "pattern": "/instapay(/|$)", "method": "POST" },
    { "pattern": "/refunds?(/|$)" },
    { "pattern": "/campaigns/[^/]+/(resume|send)" },
    { "pattern": "^/stores/:storeId/campaigns$", "method": "POST" },
    { "pattern": "/templates(?:/(?!sync$)|$)", "method": "POST" },
    { "pattern": "/conversations/[^/]+/messages$", "method": "POST" }
  ],
  "routeKinds": [
    { "match": "^/operator(/|$)", "kind": "operator" },
    { "match": "^/(webhooks|track|health|meta|t|kashier)(/|$)", "kind": "public" },
    { "match": "^/stores/:storeId(/|$)", "kind": "merchant" }
  ],
  "helpExemptAreas": ["system"],
  "smartLayerPaths": ["src/core/billing/instapay-reader.ts"]
}
