{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ebda-wa",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": { "META_GRAPH_VERSION": "v23.0" },
  "durable_objects": { "bindings": [{ "name": "WORKSPACE_DO", "class_name": "WorkspaceDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceDO"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "ebda-wa-platform", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations/d1" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ebda-wa-media" }],
  "queues": {
    "producers": [{ "binding": "SEND_QUEUE", "queue": "ebda-wa-send" }],
    "consumers": [{ "queue": "ebda-wa-send", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "ebda-wa-send-dlq" }]
  },
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "ebda_wa_usage" }]
}
