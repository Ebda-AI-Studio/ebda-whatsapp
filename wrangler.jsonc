{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ebda-wa",
  "account_id": "69188202efc4df480140dd76545aa3ab",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  // Production host (LAUNCH-SUITE-1). workers.dev stays on until wa.ebda.app is verified live, then goes off (one surface).
  "workers_dev": true,
  // The custom domain alone is NOT enough: the Store's ebda-web Worker holds the zone routes `*.ebda.app/*` and `*/*`, and a zone route
  // beats a custom domain, so wa.ebda.app served the Store's 404 until this explicit, more specific route existed (Ruling WA-ROUTE-1).
  "routes": [
    { "pattern": "wa.ebda.app", "custom_domain": true },
    { "pattern": "wa.ebda.app/*", "zone_name": "ebda.app" }
  ],
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    // WA-404-1: "none" (not the SPA fallback, which answered 200 on every path): an unknown path reaches the Worker, which answers the studio 404 page (src/addons/ebda/not-found.ts); /auth/callback is handed the shell by the Worker.
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/meta/*", "/kashier/*", "/health", "/t/*"]
  },
  "observability": { "enabled": true },
  // Workers Trace Events -> the account Logpush job ebda-workers-trace -> R2 ebda-logs (30-day lifecycle), read with ebda-foundation
  // os/ops/ebda-logs.mjs and watched by its prod-watch workflow. The job must also list "ebda-wa" in its ScriptName filter
  // (ebda-store scripts/ops/cf-logs-setup.sh). URLs and console lines land there: never log a phone number or a message body.
  "logpush": true,
  // One daily pass (Phase 7): re-send subscriptions, repair lost top-up webhooks, pull the daily USD->EGP rate (WA-FX-DAILY-1). No cron shorter than a day.
  "triggers": { "crons": ["17 1 * * *"] },
  "vars": {
    "META_GRAPH_VERSION": "v25.0",
    "IDENTITY_ISSUER": "https://accounts.ebda.app",
    "IDENTITY_JWKS_URL": "https://accounts.ebda.app/.well-known/jwks.json",
    "IDENTITY_AUDIENCE": "whatsapp",
    // Shown first in Telegram alerts (one Ebda AI Studio bot serves every product).
    "ALERT_PRODUCT": "Ebda Chat",
    "RUNBOOK_BASE_URL": "https://github.com/Whisky-11/ebda-whatsapp/blob/main/docs/runbooks/alerts",
    // Workers AI price of the default model @cf/meta/llama-3.3-70b-instruct-fp8-fast, USD per million tokens; verified 2026-10-27 against https://developers.cloudflare.com/workers-ai/platform/pricing/
    "AI_PRICE_INPUT_USD_PER_M": "0.293",
    "AI_PRICE_OUTPUT_USD_PER_M": "2.253",
    // Voice-note speech-to-text @cf/openai/whisper-large-v3-turbo, USD per audio minute; verified 2026-11-12 against https://developers.cloudflare.com/workers-ai/models/whisper-large-v3-turbo/ (46.63 neurons/min). Var VOICE_DAILY_CAP (default 60) = voice notes one store may have transcribed per UTC day.
    "AI_STT_PRICE_USD_PER_MIN": "0.000513",
    "SUPPORT_EMAIL": "ahlan@ebda.app",
    // This Worker's public origin: tracked campaign links and Store proof links are built on it.
    "PUBLIC_BASE_URL": "https://wa.ebda.app",
    // /health fails (503, alert secret_misconfigured) unless these secrets are set and well-formed; see src/core/secrets-check.ts.
    // Launch billing (Ruling WA-INSTAPAY-LAUNCH-1): merchants pay for packages and wallet top-ups by InstaPay (receipt + operator confirm). The two card switches are ON only so the
    // package list and the Wallet screen open; with no Kashier merchant id / api key every CARD route answers 503 and the Wallet offers InstaPay alone. Kashier stays unconfigured (third-party approval).
    "TOPUPS_ENABLED": "true",
    "PACKAGE_CHECKOUT_ENABLED": "true",
    "INSTAPAY_BILLING_ENABLED": "true",
    "EBDA_INSTAPAY_QR_URL": "https://media.ebda.app/platform/instapay-qr.jpg",
    // InstaPay auto-confirm notifications go to the brain (src/core/billing/instapay-notify.ts); must be a plain https URL.
    "BRAIN_BRIDGE_URL": "https://os-brain.mypovonai.com/api/instapay/notify",
    "REQUIRED_SECRETS": "TOKEN_ENC_KEY,AGENT_SECRETS_KEY,PROOF_URL_SECRET,SUITE_BUYER_KEY_SECRET,ERASURE_HMAC_KEY,BACKUP_HMAC_KEY"
  },
  "durable_objects": { "bindings": [{ "name": "WORKSPACE_DO", "class_name": "WorkspaceDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceDO"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "ebda-wa-platform", "database_id": "80c011f6-b03c-4289-b20a-102aa3ca79ef", "migrations_dir": "migrations/d1" },
    // Shared InstaPay duplicate index (docs/rulings/INSTAPAY-AUTO-1.md ruling 1.10). Created 2026-11-17 on the personal Cloudflare account (schema = DEDUPE_SCHEMA_SQL, applied). Auto-confirm still needs INSTAPAY_BRIDGE_SECRET (secret) and the brain secret of the same value, and stays mode off until an operator sets shadow.
    { "binding": "INSTAPAY_DEDUPE_DB", "database_name": "ebda-instapay-dedupe", "database_id": "2b86d92e-f14a-4270-a646-225d8b2766f6" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "ebda-wa-media" },
    { "binding": "BACKUPS", "bucket_name": "ebda-wa-backups" }
  ],
  "queues": {
    "producers": [
      { "binding": "SEND_QUEUE", "queue": "ebda-wa-send" },
      // Store link: outcomes and opt-outs to the Store (consumed by ebda-api).
      { "binding": "STORE_EVENTS", "queue": "ebda-store-events" }
    ],
    "consumers": [
      { "queue": "ebda-wa-send", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "ebda-wa-send-dlq" },
      // The dead letters: marked failed + a P1 `send_dlq` alert (src/core/send-queue.ts consumeSendDlq). Nothing else may consume this queue.
      { "queue": "ebda-wa-send-dlq", "max_batch_size": 10, "max_retries": 2 },
      // Store link: events from the Store (ebda-api produces). One consumer per queue; checked empty 2026-10-28.
      { "queue": "ebda-wa-events", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "ebda-wa-events-dlq" }
    ]
  },
  // Workers AI: the AI agent's default model and the knowledge-base embeddings (@cf/baai/bge-m3). Billed to this account.
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "ebda-wa-kb" }],
  "analytics_engine_datasets": [
    { "binding": "USAGE", "dataset": "ebda_wa_usage" },
    { "binding": "CI_OUTCOMES", "dataset": "ebda_ci_outcomes" },
    { "binding": "LINK_CLICKS", "dataset": "ebda_wa_link_clicks" }
  ],
  // Phase 6: contact imports (parsed in steps) and campaign broadcasts (paged, paced against the number's tier) run as Workflows.
  "workflows": [
    { "name": "ebda-wa-import", "binding": "IMPORT_WORKFLOW", "class_name": "ImportWorkflow" },
    { "name": "ebda-wa-campaign", "binding": "CAMPAIGN_WORKFLOW", "class_name": "CampaignWorkflow" }
  ],
  // Session revocation for top-ups, package checkout and operator writes (fail closed when the call fails).
  "services": [
    { "binding": "ACCOUNTS", "service": "ebda-accounts", "entrypoint": "Accounts" },
    // Store link (Phase 4, Ruling WA-LINK-ON-1): the Store API Worker's RPC entrypoint. The Worker must be deployed or the whole deploy fails.
    { "binding": "STORE_BRIDGE", "service": "ebda-api", "entrypoint": "WhatsAppBridge" }
  ]
  // ---- Billing (Phase 7). Switches and secrets (see docs/billing.md). Kashier-only settings below stay unset until Kashier is approved (the switches themselves are ON in vars, see WA-INSTAPAY-LAUNCH-1):
  //   vars: TOPUPS_ENABLED ("true"), PACKAGE_CHECKOUT_ENABLED ("true", self-serve packages, default off), KASHIER_MERCHANT_ID, KASHIER_FEE_BPS, KASHIER_FEE_FIXED_MINOR, ADJUSTMENT_APPROVAL_MINOR, ADJUSTMENT_DAILY_CAP
  //   secret: KASHIER_API_KEY and KASHIER_SECRET_KEY (`wrangler secret put`; the Secret key confirms webhooks, vars KASHIER_API_URL optional); service binding ACCOUNTS is required for top-ups and operator writes (fail closed
  //   otherwise). RPC: isRevoked(sid) → true for an unknown sid. The ebda-accounts Worker is live (2026-10-25).
  // ---- InstaPay billing (the launch payment method until Kashier is approved): var INSTAPAY_BILLING_ENABLED ("true", default off), var EBDA_INSTAPAY_QR_URL (https only), var EBDA_INSTAPAY_PAYEE_NAME (optional),
  //   secret EBDA_INSTAPAY_HANDLE (`wrangler secret put`; the SAME value as ebda-api). Unset handle = InstaPay billing answers 503. See docs/billing.md.
  // Before a platform-paid number sends: publish a rate card + FX through /api/v1/operator and set the number's funding.
  // ---- AI agent (Phase 5). The knowledge base and the catalog search use the Vectorize index below (1024 dimensions = @cf/baai/bge-m3, cosine; Ruling WA-VECTORIZE-1).
  // The binding is live: the index MUST exist before the deploy (a binding to a missing index fails the deploy), and /health answers 503 if the binding is absent at runtime.
  // Create it once, on this account, before deploying: `npx wrangler vectorize create ebda-wa-kb --dimensions=1024 --metric=cosine`
  // Secrets: AGENT_SECRETS_KEY (base64, 32 random bytes; encrypts merchants' own model keys). Var AGENT_MODEL overrides the default Workers AI model; the operator flag agent.model (WA-MODEL-FLAG-1) picks between the two allowed ids at runtime, and AI_PRICE_*_GPT_OSS price the second one.
  // ---- Own number (Phase 8.1, docs/numbers.md). Var EMBEDDED_SIGNUP_ENABLED="1" turns the /numbers routes on; secrets TOKEN_ENC_KEY (base64, 32 random bytes) and
  // META_APP_ID are then required (a request answers 503 naming the missing key). META_APP_SECRET and META_SYSTEM_TOKEN are already secrets.
  // ---- Store link (Phase 4): ON (Ruling WA-LINK-ON-1). Bindings are in services / queues above; PROOF_URL_SECRET (secret) and PUBLIC_BASE_URL (var) are set.
  // `WhatsAppOtp` (a store's customers, from the store's number) is bound by no Worker. Platform account codes use the `PlatformOtp` entrypoint (accounts binds it), which stays `disabled` until the platform number exists: then set vars PLATFORM_OTP_PHONE_NUMBER_ID and PLATFORM_OTP_TEMPLATE (Ruling WA-OTP-SENDER-1).
}
