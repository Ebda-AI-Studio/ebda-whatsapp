{
 "version": 1,
 "cases": [
  {
   "name": "meaning search with a budget",
   "method": "searchProducts",
   "args": [
    "11111111-1111-4111-8111-111111111111",
    "هدية",
    {
     "maxPriceMinor": 30000,
     "limit": 5
    }
   ],
   "expect": {
    "ok": true,
    "value": {
     "items": [
      {
       "retailerId": "v1",
       "productId": "p-v1",
       "title": "Item v1",
       "titleAr": null,
       "description": null,
       "priceMinor": 25000,
       "currency": "EGP",
       "availability": "in_stock",
       "imageUrl": null,
       "link": "https://dar-mona.ebda.app/products/v1",
       "brand": null
      }
     ]
    }
   }
  },
  {
   "name": "search with no hit is ok + empty",
   "method": "searchProducts",
   "args": [
    "11111111-1111-4111-8111-111111111111",
    "zzz",
    {
     "limit": 5
    }
   ],
   "expect": {
    "ok": true,
    "value": {
     "items": []
    }
   }
  },
  {
   "name": "search with a blank query is invalid",
   "method": "searchProducts",
   "args": [
    "11111111-1111-4111-8111-111111111111",
    " ",
    {
     "limit": 5
    }
   ],
   "expect": {
    "ok": false,
    "reason": "invalid",
    "message": "searchProducts: query"
   }
  },
  {
   "name": "search of an unknown store is not_found",
   "method": "searchProducts",
   "args": [
    "33333333-3333-4333-8333-333333333333",
    "x",
    {
     "limit": 5
    }
   ],
   "expect": {
    "ok": false,
    "reason": "not_found",
    "message": "store not resolved"
   }
  },
  {
   "name": "store policies",
   "method": "getStorePolicies",
   "args": [
    "11111111-1111-4111-8111-111111111111"
   ],
   "expect": {
    "ok": true,
    "value": {
     "nameAr": "دار منى",
     "shipping": {
      "zones": [
       {
        "name": "Cairo",
        "nameAr": "القاهرة",
        "areas": [
         "Maadi",
         "Nasr City"
        ],
        "feeMinor": 6000,
        "freeOverMinor": 100000,
        "etaDaysMin": 1,
        "etaDaysMax": 2
       }
      ],
      "governorates": [
       {
        "governorate": "Giza",
        "governorateAr": "الجيزة",
        "feeMinor": 6000,
        "feeMaxMinor": 8000,
        "freeOverMinor": null
       }
      ]
     },
     "returns": {
      "windowDays": 14,
      "feesPaidBy": "customer"
     },
     "cod": {
      "available": true,
      "fixedFeeMinor": 2500,
      "percentBps": null
     },
     "hours": "Sat-Thu 10am-10pm",
     "location": {
      "address": "9 Road 233, Maadi",
      "addressAr": null,
      "mapsUrl": null
     },
     "name": "Dar Mona",
     "currency": "EGP",
     "locale": "ar",
     "paymentMethods": [
      "cod",
      "link",
      "instapay"
     ],
     "instapay": true
    }
   }
  },
  {
   "name": "store policies of an unlinked store is not_linked",
   "method": "getStorePolicies",
   "args": [
    "22222222-2222-4222-8222-222222222222"
   ],
   "expect": {
    "ok": false,
    "reason": "not_linked"
   }
  },
  {
   "name": "customer profile by phone",
   "method": "getCustomerProfile",
   "args": [
    "11111111-1111-4111-8111-111111111111",
    "+201001234567"
   ],
   "expect": {
    "ok": true,
    "value": {
     "firstName": "Mona",
     "preferredLocale": "ar",
     "defaultAddress": {
      "id": "a1",
      "label": "Home",
      "area": "Maadi",
      "street": "9 Road 233",
      "governorate": "Cairo",
      "buildingNumber": "4",
      "notes": null
     },
     "recentOrders": [
      {
       "orderNumber": "EB-900",
       "status": "delivered",
       "totalMinor": 25000,
       "currency": "EGP",
       "at": 1762000000000,
       "items": [
        {
         "name": "Item v1",
         "quantity": 1
        }
       ]
      }
     ]
    }
   }
  },
  {
   "name": "customer profile of an unknown phone is null, not an error",
   "method": "getCustomerProfile",
   "args": [
    "11111111-1111-4111-8111-111111111111",
    "+201999999999"
   ],
   "expect": {
    "ok": true,
    "value": null
   }
  },
  {
   "name": "customer profile needs a valid phone",
   "method": "getCustomerProfile",
   "args": [
    "11111111-1111-4111-8111-111111111111",
    "nope"
   ],
   "expect": {
    "ok": false,
    "reason": "invalid",
    "message": "getCustomerProfile: phoneE164"
   }
  }
 ]
}
